# Variáveis da API em produção. Na VM: copiar pra infra/api.env e
# preencher LÁ — nunca no repo nem em chat. O que cada uma faz está em
# apps/api/.env.example. A DATABASE_URL não entra aqui: o compose monta
# a partir do infra/.env. O NODE_ENV=production vem da imagem.
#
# Em produção a API NÃO sobe sem: JWT_SECRET, o canal de e-mail, o S3,
# PROXIES_CONFIAVEIS, ORIGENS_PERMITIDAS, a Stripe e a CHAVE_DE_CIFRA.

# Gerar com `openssl rand -hex 48`.
JWT_SECRET=

# Lembretes, códigos e convites saem por e-mail (Resend, ADR-0009).
CANAL_DE_MENSAGEM=email
RESEND_API_KEY=
EMAIL_REMETENTE=BarChop <nao-responda@barchop.com.br>

# Endereços públicos (ADR-0002).
URL_DO_PAINEL=https://painel.barchop.com.br
URL_DAS_BARBEARIAS=https://{slug}.barchop.com.br

# Capa e fotos no Object Storage da OCI (bucket com leitura pública dos
# objetos e SEM listagem; chave = Customer Secret Key). <regiao> é o
# identificador da região da tenancy (ex.: sa-saopaulo-1) e <namespace>
# o namespace do Object Storage (página do bucket no console).
ARMAZENAMENTO=s3
S3_ENDPOINT=https://<namespace>.compat.objectstorage.<regiao>.oraclecloud.com
S3_REGIAO=<regiao>
S3_BUCKET=barchop-imagens
S3_CHAVE_DE_ACESSO=
S3_SEGREDO=
URL_PUBLICA_DAS_IMAGENS=https://objectstorage.<regiao>.oraclecloud.com/n/<namespace>/b/barchop-imagens/o

# A borda: um salto (o Caddy) e os sites que chamam a API do navegador.
PROXIES_CONFIAVEIS=1
ORIGENS_PERMITIDAS=https://painel.barchop.com.br,https://www.barchop.com.br,https://*.barchop.com.br

# WhatsApp desligado até a Meta aprovar (ADR-0009).
WHATSAPP_ATIVO=false

# A cobrança pela Stripe (ADR-0010): sem as duas, a API não sobe. As
# chaves do modo REAL (sk_live_...). O segredo do webhook sai do endpoint
# https://api.barchop.com.br/stripe/webhook no painel da Stripe. Depois de
# subir, rodar uma vez: `docker compose exec api node dist/criar-precos-no-stripe.js`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Pagamentos online dos planos de assinatura (Asaas; plano
# .claude/plans/planos-de-assinatura.plan.md).
#
# A chave que cifra as chaves do Asaas dos vendedores no banco
# (AES-256-GCM). Gerar com `openssl rand -base64 32`: 32 bytes em base64.
# Guardar uma cópia FORA da VM: perdê-la obriga todo vendedor a conectar
# a conta de novo. Sem ela (ou torta), a API não sobe.
CHAVE_DE_CIFRA=

# O endereço público da API: o Asaas manda os eventos da conta conectada
# pra <URL_DA_API>/webhooks/asaas/<conexão>. Sem ela, conectar responde 503.
URL_DA_API=https://api.barchop.com.br

# O modo das chaves do Asaas que a plataforma aceita. Vazio é o normal:
# em produção, só chave de produção (`real`). `teste` (chave do sandbox)
# só no teste ponta a ponta de um dia; depois, voltar a vazio.
PAGAMENTOS_ONLINE_MODO=
