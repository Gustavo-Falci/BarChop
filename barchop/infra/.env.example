# Variáveis do compose (infra/compose.yaml). Na VM: copiar pra
# infra/.env e preencher LÁ — nunca no repo nem em chat. As da API
# moram em api.env (ver api.env.example).

# Banco. A senha entra crua na DATABASE_URL que o compose monta: gerar
# só hexadecimal, com `openssl rand -hex 24`.
POSTGRES_USER=barchop
POSTGRES_PASSWORD=
POSTGRES_DB=barchop

# Certificados (Caddy, desafio DNS-01). Token da Cloudflare com as DUAS
# permissões que o caddy-dns/cloudflare pede, só na zona barchop.com.br:
# Zone → Zone → Read e Zone → DNS → Edit. Só com o Edit a emissão falha.
# O e-mail recebe os avisos da Let's Encrypt.
CLOUDFLARE_API_TOKEN=
ACME_EMAIL=

# Embutidas no JavaScript do web na hora do build (web.Dockerfile):
# trocar uma delas pede `docker compose build web`.
NEXT_PUBLIC_API_URL=https://api.barchop.com.br
NEXT_PUBLIC_URL_DO_SITE=https://barchop.com.br

# Quem vende, nos termos e na privacidade (pessoa física: a lei do
# comércio eletrônico pede nome e CPF). Só aqui, nunca no repositório,
# que é público. CPF com ou sem pontuação.
NEXT_PUBLIC_VENDEDOR_NOME=
NEXT_PUBLIC_VENDEDOR_CPF=
NEXT_PUBLIC_VENDEDOR_EMAIL=

# O papel com que a API e a migração conectam, sem superusuário. Deixar
# os dois VAZIOS até rodar o roteiro que cria o papel (README, "Papel do
# banco"): vazios, a conexão continua pelo POSTGRES_USER. Senha só
# hexadecimal, com `openssl rand -hex 24`.
APP_DB_USER=
APP_DB_PASSWORD=

# Quantos dias de backup diário guardar no disco da VM.
BACKUP_DIAS=14

# Cópia do backup fora da VM, cifrada (README, "Backup"). Com o bucket
# vazio ela fica desligada e o backup só existe no disco da VM.
# - A chave é a PÚBLICA do age (começa com `age1`). A privada NÃO vem pra
#   cá: fica com o dono, fora da VM.
# - O bucket é PRIVADO e só de backup — nunca o das imagens, que é de
#   leitura pública. A credencial é só dele, e só precisa escrever.
BACKUP_CHAVE_PUBLICA=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGIAO=
BACKUP_S3_BUCKET=
BACKUP_S3_CHAVE_DE_ACESSO=
BACKUP_S3_SEGREDO=
