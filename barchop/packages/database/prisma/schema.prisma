generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A EXCLUDE USING gist (que trava conflito de horário) e a coluna
// `periodo` gerada não têm representação no schema declarativo do
// Prisma — elas são adicionadas à mão na migration inicial.
// Veja prisma/migrations/20260829120000_init/migration.sql.

enum StatusAgendamento {
  pendente
  confirmado
  concluido
  cancelado
  no_show

  @@map("status_agendamento")
}

// O que o membro da equipe pode fazer no painel. A matriz de rotas por
// papel mora em apps/api/src/plugins/auth.ts.
enum PapelMembro {
  dono
  profissional
  recepcao

  @@map("papel_membro")
}

// Cada dia da jornada do membro: acompanha o horário da barbearia, tem
// horas próprias, ou é folga. Ver 20261004120000_jornada_servicos_bloqueio.
enum ModoJornada {
  barbearia
  proprio
  folga

  @@map("modo_jornada")
}

enum OrigemAgendamento {
  cliente
  barbeiro

  @@map("origem_agendamento")
}

model Barbearia {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                      String   @db.VarChar(120)
  slug                      String   @unique @db.VarChar(80)
  telefone                  String?  @db.VarChar(20)
  endereco                  String?  @db.VarChar(255)
  logoUrl                   String?  @map("logo_url")
  // Texto de apresentação da home pública: o que a barbearia diz de si
  // pra quem abriu o link no WhatsApp. Anulável porque toda barbearia
  // já cadastrada nasce sem ele, e porque a home tem que funcionar sem
  // — quem acabou de criar a conta ainda não escreveu nada.
  sobre                     String?  @db.VarChar(1000)
  // Quanto antes do horário sai o lembrete: 2, 12 ou 24 (CHECK na
  // migration 20261004130000_lembrete).
  lembreteAntecedenciaHoras Int      @default(24) @map("lembrete_antecedencia_horas") @db.SmallInt
  // Interruptor do lembrete (G2c). Ligado nas barbearias novas.
  lembreteAtivo             Boolean  @default(true) @map("lembrete_ativo")
  // Áreas das Configurações salvas pelo menos uma vez (painel v2). Só
  // cresce; a API marca no salvar (@barchop/formato/areas).
  areasDecididas            String[] @default([]) @map("areas_decididas")
  // A página pública rica (bloco E1). Listas fechadas: os valores moram
  // em packages/formato/src/pagina.ts, e a migration
  // 20261004160000_pagina_da_barbearia tem o CHECK com os mesmos.
  whatsapp                  String?  @db.VarChar(20)
  instagram                 String?  @db.VarChar(30)
  comodidades               String[] @default([])
  formasDePagamento         String[] @default([]) @map("formas_pagamento")
  // Chave da capa no armazenamento (bloco E2); a URL sai da config.
  capaChave                 String?  @map("capa_chave") @db.VarChar(200)
  // As duas marcas da trilha de primeiros passos (bloco F2) que não se
  // deduzem do resto: o link copiado e o "trabalho sozinho".
  linkCompartilhadoEm       DateTime? @map("link_compartilhado_em") @db.Timestamptz
  trabalhaSozinho           Boolean  @default(false) @map("trabalha_sozinho")
  criadoEm                  DateTime @default(now()) @map("criado_em") @db.Timestamptz

  barbeiros             Barbeiro[]
  clientes              Cliente[]
  servicos              Servico[]
  horariosFuncionamento HorarioFuncionamento[]
  agendamentos          Agendamento[]
  codigosVerificacao    CodigoVerificacao[]
  bloqueios             Bloqueio[]
  slugsAntigos          SlugAntigo[]
  solicitacoesDeLink    SolicitacaoTrocaLink[]

  @@map("barbearia")
}

// O suporte da plataforma (bloco F4): avalia os pedidos de troca de
// link. Não é membro de barbearia nenhuma; a conta nasce só por comando
// (apps/api/scripts/criar-suporte.ts).
model OperadorSuporte {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome            String    @db.VarChar(120)
  email           String    @unique @db.VarChar(160)
  senhaHash       String    @map("senha_hash")
  ativo           Boolean   @default(true)
  senhaAlteradaEm DateTime? @map("senha_alterada_em") @db.Timestamptz
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  decisoes SolicitacaoTrocaLink[]

  @@map("operador_suporte")
}

// O pedido do dono pra trocar o link (bloco F4). status: pendente,
// aprovada, recusada ou cancelada (CHECK na migration
// 20261004200000_suporte); uma pendente por barbearia (índice parcial).
model SolicitacaoTrocaLink {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId String    @map("barbearia_id") @db.Uuid
  slugPedido  String    @map("slug_pedido") @db.VarChar(80)
  motivo      String?   @db.VarChar(500)
  status      String    @default("pendente") @db.VarChar(20)
  resposta    String?   @db.VarChar(500)
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  decididoEm  DateTime? @map("decidido_em") @db.Timestamptz
  decididoPor String?   @map("decidido_por") @db.Uuid

  barbearia Barbearia        @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  operador  OperadorSuporte? @relation(fields: [decididoPor], references: [id], onDelete: SetNull)

  @@index([status, criadoEm])
  @@map("solicitacao_troca_link")
}

// Slugs que a barbearia já teve (bloco E3): o link antigo continua
// achando ela. O atual de qualquer barbearia ganha do antigo — quem nasce
// ou troca para um slug daqui apaga a linha (migration
// 20261004180000_slug_antigo).
model SlugAntigo {
  slug        String   @id @db.VarChar(80)
  barbeariaId String   @map("barbearia_id") @db.Uuid
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@index([barbeariaId])
  @@map("slug_antigo")
}

model HorarioFuncionamento {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId    String    @map("barbearia_id") @db.Uuid
  diaSemana      Int       @map("dia_semana") @db.SmallInt
  horaAbertura   DateTime? @map("hora_abertura") @db.Time
  horaFechamento DateTime? @map("hora_fechamento") @db.Time
  fechado        Boolean   @default(false)

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@unique([barbeariaId, diaSemana])
  @@map("horario_funcionamento")
}

model Barbeiro {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId     String      @map("barbearia_id") @db.Uuid
  nome            String      @db.VarChar(120)
  email           String?     @unique @db.VarChar(160)
  // Nulo enquanto o membro convidado não define a senha; o login recusa.
  senhaHash       String?     @map("senha_hash")
  telefone        String?     @db.VarChar(20)
  ativo           Boolean     @default(true)
  papel           PapelMembro @default(profissional)
  // Aparece na agenda e no fluxo público. A recepção nasce com false.
  atende          Boolean     @default(true)
  // Chave da foto no armazenamento (bloco E2); a URL sai da config.
  fotoChave       String?     @map("foto_chave") @db.VarChar(200)
  criadoEm        DateTime    @default(now()) @map("criado_em") @db.Timestamptz
  // Token com `iat` anterior a isto é recusado (plugins/auth.ts).
  senhaAlteradaEm DateTime?   @map("senha_alterada_em") @db.Timestamptz

  barbearia    Barbearia             @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]
  // Sete linhas sempre, e todos os serviços ao nascer: quem garante é o
  // trigger do insert (migration 20261004120000), não as rotas.
  jornada      JornadaProfissional[]
  servicos     ProfissionalServico[]
  bloqueios    Bloqueio[]

  @@index([barbeariaId])
  @@map("barbeiro")
}

model JornadaProfissional {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeiroId String      @map("barbeiro_id") @db.Uuid
  diaSemana  Int         @map("dia_semana") @db.SmallInt
  modo       ModoJornada @default(barbearia)
  // Só no modo `proprio`, e as duas — CHECK `jornada_horas_do_modo`.
  horaInicio DateTime?   @map("hora_inicio") @db.Time
  horaFim    DateTime?   @map("hora_fim") @db.Time
  // Pausa do almoço (painel v2, marco 3): as duas ou nenhuma, nunca na
  // folga — CHECK `jornada_pausa_inteira` (migration 20261008120000).
  pausaInicio DateTime?  @map("pausa_inicio") @db.Time
  pausaFim    DateTime?  @map("pausa_fim") @db.Time

  barbeiro Barbeiro @relation(fields: [barbeiroId], references: [id], onDelete: Cascade)

  @@unique([barbeiroId, diaSemana])
  @@map("jornada_profissional")
}

model ProfissionalServico {
  barbeiroId String @map("barbeiro_id") @db.Uuid
  servicoId  String @map("servico_id") @db.Uuid

  barbeiro Barbeiro @relation(fields: [barbeiroId], references: [id], onDelete: Cascade)
  servico  Servico  @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@id([barbeiroId, servicoId])
  @@index([servicoId])
  @@map("profissional_servico")
}

// Período de datas; sem horas é o dia inteiro, com horas é a mesma faixa
// em cada dia do período. CHECKs `bloqueio_periodo` e `bloqueio_horas`.
model Bloqueio {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId String    @map("barbearia_id") @db.Uuid
  barbeiroId  String    @map("barbeiro_id") @db.Uuid
  dataInicio  DateTime  @map("data_inicio") @db.Date
  dataFim     DateTime  @map("data_fim") @db.Date
  horaInicio  DateTime? @map("hora_inicio") @db.Time
  horaFim     DateTime? @map("hora_fim") @db.Time
  motivo      String?   @db.VarChar(120)
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  barbeiro  Barbeiro  @relation(fields: [barbeiroId], references: [id], onDelete: Cascade)

  @@index([barbeiroId, dataInicio, dataFim])
  @@index([barbeariaId, dataInicio])
  @@map("bloqueio")
}

model Cliente {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId     String    @map("barbearia_id") @db.Uuid
  nome            String    @db.VarChar(120)
  telefone        String    @db.VarChar(20)
  email           String?   @db.VarChar(160)
  senhaHash       String?   @map("senha_hash")
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  // Token com `iat` anterior a isto é recusado (plugins/auth.ts).
  senhaAlteradaEm DateTime? @map("senha_alterada_em") @db.Timestamptz

  barbearia    Barbearia     @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]

  // Telefone é único dentro da barbearia, não na plataforma: o mesmo
  // cliente pode ser cliente de duas barbearias, com um cadastro em
  // cada uma. É esse par que o upsert por telefone da fase 4 usa.
  @@unique([barbeariaId, telefone])
  @@unique([barbeariaId, email])
  @@index([barbeariaId])
  @@map("cliente")
}

model Servico {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId    String   @map("barbearia_id") @db.Uuid
  nome           String   @db.VarChar(120)
  duracaoMinutos Int      @map("duracao_minutos") @db.SmallInt
  preco          Decimal  @db.Decimal(10, 2)
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz
  // Agrupa os serviços na página pública. Texto livre e opcional.
  categoria      String?  @db.VarChar(60)
  // Texto curto do cartão na página pública. Opcional.
  descricao      String?  @db.VarChar(300)
  // Chave da foto no armazenamento, como a do barbeiro; a URL sai da config.
  fotoChave      String?  @map("foto_chave") @db.VarChar(200)

  barbearia           Barbearia             @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  agendamentoServicos AgendamentoServico[]
  profissionais       ProfissionalServico[]

  @@index([barbeariaId])
  @@map("servico")
}

model Agendamento {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId          String            @map("barbearia_id") @db.Uuid
  barbeiroId           String            @map("barbeiro_id") @db.Uuid
  clienteId            String            @map("cliente_id") @db.Uuid
  data                 DateTime          @db.Date
  horaInicio           DateTime          @map("hora_inicio") @db.Time
  horaFim              DateTime          @map("hora_fim") @db.Time
  status               StatusAgendamento @default(confirmado)
  origem               OrigemAgendamento @default(cliente)
  observacoes          String?
  criadoEm             DateTime          @default(now()) @map("criado_em") @db.Timestamptz
  // Marca de idempotência do lembrete (ver apps/api/src/lib/lembrete.ts).
  lembreteEnviadoEm    DateTime?         @map("lembrete_enviado_em") @db.Timestamptz
  // Confirmação de presença pelo link do lembrete (routers/lembretes.ts).
  presencaConfirmadaEm DateTime?         @map("presenca_confirmada_em") @db.Timestamptz
  // E-mail digitado ao marcar pela página pública, só pro lembrete deste
  // agendamento — nunca vai pro cadastro (ver a migration
  // 20261004150000_email_do_lembrete).
  emailLembrete        String?           @map("email_lembrete") @db.VarChar(160)

  barbearia Barbearia            @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  barbeiro  Barbeiro             @relation(fields: [barbeiroId], references: [id])
  cliente   Cliente              @relation(fields: [clienteId], references: [id])
  servicos  AgendamentoServico[]

  @@index([barbeiroId, data])
  @@index([clienteId])
  @@index([barbeariaId, data])
  @@map("agendamento")
}

model AgendamentoServico {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agendamentoId    String  @map("agendamento_id") @db.Uuid
  servicoId        String  @map("servico_id") @db.Uuid
  precoNoMomento   Decimal @map("preco_no_momento") @db.Decimal(10, 2)
  duracaoNoMomento Int     @map("duracao_no_momento") @db.SmallInt

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  servico     Servico     @relation(fields: [servicoId], references: [id])

  @@index([agendamentoId])
  @@map("agendamento_servico")
}

// O código de verificação do primeiro acesso e da recuperação de senha.
// Criado à mão na migration 20261001120000_codigo_verificacao — ver lá
// por que o código nunca é guardado em texto.
model CodigoVerificacao {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  finalidade  String    @db.VarChar(40)
  // Telefone ou e-mail, já normalizado: é o mesmo valor que a busca usa.
  destino     String    @db.VarChar(160)
  barbeariaId String?   @map("barbearia_id") @db.Uuid
  codigoHash  String    @map("codigo_hash")
  tentativas  Int       @default(0) @db.SmallInt
  expiraEm    DateTime  @map("expira_em") @db.Timestamptz
  usadoEm     DateTime? @map("usado_em") @db.Timestamptz
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  barbearia Barbearia? @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@index([finalidade, destino, barbeariaId, criadoEm(sort: Desc)], map: "codigo_verificacao_alvo_idx")
  @@map("codigo_verificacao")
}
