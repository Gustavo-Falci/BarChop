{
  "name": "@barchop/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "criar-suporte": "tsx --env-file-if-exists=.env scripts/criar-suporte.ts",
    "titular": "tsx --env-file-if-exists=.env scripts/titular.ts",
    "criar-precos": "tsx --env-file-if-exists=.env scripts/criar-precos-no-stripe.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@barchop/database": "workspace:*",
    "@barchop/formato": "workspace:*",
    "@barchop/scheduling": "workspace:*",
    "@barchop/types": "workspace:*",
    "@fastify/cors": "^11.4.3",
    "@fastify/jwt": "^10.2.8",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/type-provider-json-schema-to-ts": "^5.0.1",
    "fastify": "^5.12.8",
    "pg-boss": "^12.36.0",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@barchop/config": "workspace:*",
    "@types/node": "^22.0.0",
    "dotenv": "^17.4.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
