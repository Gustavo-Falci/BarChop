generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A EXCLUDE USING gist (que trava conflito de horário) e a coluna
// `periodo` gerada não têm representação no schema declarativo do
// Prisma — elas são adicionadas à mão na migration inicial.
// Veja prisma/migrations/20260829120000_init/migration.sql.

enum StatusAgendamento {
  pendente
  confirmado
  concluido
  cancelado
  no_show

  @@map("status_agendamento")
}

// O que o membro da equipe pode fazer no painel. A matriz de rotas por
// papel mora em apps/api/src/plugins/auth.ts.
enum PapelMembro {
  dono
  profissional
  recepcao

  @@map("papel_membro")
}

// Cada dia da jornada do membro: acompanha o horário da barbearia, tem
// horas próprias, ou é folga. Ver 20261004120000_jornada_servicos_bloqueio.
enum ModoJornada {
  barbearia
  proprio
  folga

  @@map("modo_jornada")
}

enum OrigemAgendamento {
  cliente
  barbeiro

  @@map("origem_agendamento")
}

model Barbearia {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                      String    @db.VarChar(120)
  slug                      String    @unique @db.VarChar(80)
  telefone                  String?   @db.VarChar(20)
  endereco                  String?   @db.VarChar(255)
  // Texto de apresentação da home pública: o que a barbearia diz de si
  // pra quem abriu o link no WhatsApp. Anulável porque toda barbearia
  // já cadastrada nasce sem ele, e porque a home tem que funcionar sem
  // — quem acabou de criar a conta ainda não escreveu nada.
  sobre                     String?   @db.VarChar(1000)
  // Quanto antes do horário sai o lembrete: 2, 12 ou 24 (CHECK na
  // migration 20261004130000_lembrete).
  lembreteAntecedenciaHoras Int       @default(24) @map("lembrete_antecedencia_horas") @db.SmallInt
  // Interruptor do lembrete (G2c). Ligado nas barbearias novas.
  lembreteAtivo             Boolean   @default(true) @map("lembrete_ativo")
  // Áreas das Configurações salvas pelo menos uma vez (painel v2). Só
  // cresce; a API marca no salvar (@barchop/formato/areas).
  areasDecididas            String[]  @default([]) @map("areas_decididas")
  // A página pública rica (bloco E1). Listas fechadas: os valores moram
  // em packages/formato/src/pagina.ts, e a migration
  // 20261004160000_pagina_da_barbearia tem o CHECK com os mesmos.
  whatsapp                  String?   @db.VarChar(20)
  instagram                 String?   @db.VarChar(30)
  comodidades               String[]  @default([])
  formasDePagamento         String[]  @default([]) @map("formas_pagamento")
  // Chave da capa no armazenamento (bloco E2); a URL sai da config.
  capaChave                 String?   @map("capa_chave") @db.VarChar(200)
  // A logo, como a capa: a chave no armazenamento, e o formato da
  // moldura (redonda, quadrada ou livre — CHECK na migration
  // 20261010120000_logo_da_barbearia, lista em @barchop/formato).
  logoChave                 String?   @map("logo_chave") @db.VarChar(200)
  logoFormato               String?   @map("logo_formato")
  // As duas marcas da trilha de primeiros passos (bloco F2) que não se
  // deduzem do resto: o link copiado e o "trabalho sozinho".
  linkCompartilhadoEm       DateTime? @map("link_compartilhado_em") @db.Timestamptz
  trabalhaSozinho           Boolean   @default(false) @map("trabalha_sozinho")
  // Regras de agendamento (painel v2, marco 3): só pro cliente, o
  // painel encaixa livre. Listas fechadas em packages/formato/src/
  // regras.ts, com o CHECK na migration 20261009120000_regras_de_agendamento.
  // Os padrões são o comportamento de antes das regras.
  intervaloMinutos          Int       @default(15) @map("intervalo_minutos") @db.SmallInt
  antecedenciaMinutos       Int       @default(0) @map("antecedencia_minutos") @db.SmallInt
  aceitaMesmoDia            Boolean   @default(true) @map("aceita_mesmo_dia")
  // Nula = sem limite.
  janelaDias                Int?      @map("janela_dias") @db.SmallInt
  cabeAntesDeFechar         Boolean   @default(true) @map("cabe_antes_de_fechar")
  prazoRemarcarHoras        Int       @default(0) @map("prazo_remarcar_horas") @db.SmallInt
  prazoCancelarHoras        Int       @default(0) @map("prazo_cancelar_horas") @db.SmallInt
  // A Aparência da página pública: o que está no ar e o rascunho que o
  // dono ainda não publicou. Nulas = o padrão / nada pendente. Formato
  // em packages/formato/src/aparencia.ts; a API valida, quem lê
  // normaliza (migration 20261012120000_aparencia).
  aparencia                 Json?
  aparenciaRascunho         Json?     @map("aparencia_rascunho")
  // As categorias na ordem que o dono escolheu. Vazia = a padrão de
  // CATEGORIAS_DE_SERVICO; a que faltar vai pro fim (`ordenarCategorias`,
  // @barchop/formato). CHECK na migration 20261021120000_ordem.
  ordemCategorias           String[]  @default([]) @map("ordem_categorias")
  // Os planos do cliente aparecem na página pública (marco 3 da Onda 2,
  // migration 20261026120000_planos_de_assinatura).
  vitrineDePlanos           Boolean   @default(false) @map("vitrine_de_planos")
  criadoEm                  DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  barbeiros             Barbeiro[]
  clientes              Cliente[]
  servicos              Servico[]
  horariosFuncionamento HorarioFuncionamento[]
  excecoesDeHorario     ExcecaoHorario[]
  agendamentos          Agendamento[]
  codigosVerificacao    CodigoVerificacao[]
  bloqueios             Bloqueio[]
  slugsAntigos          SlugAntigo[]
  solicitacoesDeLink    SolicitacaoTrocaLink[]
  assinatura            Assinatura?
  regrasDeDivisao       RegraDeDivisao[]
  pagamentos            Pagamento[]
  fechamentos           FechamentoDoDia[]
  // Os planos do cliente (migration 20261026120000_planos_de_assinatura).
  conexoesDePagamento   ConexaoDePagamento[]
  planosDeAssinatura    PlanoDeAssinatura[]
  assinaturasDeClientes AssinaturaDoCliente[]
  recebimentosDePlanos  RecebimentoDoPlano[]

  @@map("barbearia")
}

// A assinatura do BarChop (Onda 2, marco 1): uma por barbearia, nasce
// no cadastro em teste. Listas fechadas (plano, ciclo, situação) em
// packages/formato/src/planos.ts, com o CHECK na migration
// 20261014120000_assinatura. A Stripe é a fonte da verdade do que foi
// pago; aqui fica a cópia que o webhook mantém (ADR-0010).
model Assinatura {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId              String    @unique @map("barbearia_id") @db.Uuid
  situacao                 String    @default("teste")
  // O plano contratado. No teste vale o Completo, seja qual for este
  // (planoEfetivo em @barchop/formato).
  plano                    String    @default("gratis")
  ciclo                    String    @default("mensal")
  // Obrigatório quando a situação é `teste` (CHECK).
  testeTerminaEm           DateTime? @map("teste_termina_em") @db.Timestamptz
  stripeCustomerId         String?   @unique @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId     String?   @unique @map("stripe_subscription_id") @db.VarChar(255)
  // A quantidade cobrada na Stripe; nula sem plano pago.
  profissionaisContratados Int?      @map("profissionais_contratados") @db.SmallInt
  periodoTerminaEm         DateTime? @map("periodo_termina_em") @db.Timestamptz
  // Cancelada no Portal: a Stripe segue `active` até esta data.
  cancelaEm                DateTime? @map("cancela_em") @db.Timestamptz
  criadaEm                 DateTime  @default(now()) @map("criada_em") @db.Timestamptz
  atualizadaEm             DateTime  @default(now()) @updatedAt @map("atualizada_em") @db.Timestamptz

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@map("assinatura")
}

// Os eventos do webhook da Stripe já processados: o id do evento é a
// chave, então o mesmo evento entregue duas vezes só vale uma.
model EventoStripe {
  id           String   @id @db.VarChar(255)
  tipo         String   @db.VarChar(100)
  processadoEm DateTime @default(now()) @map("processado_em") @db.Timestamptz

  @@map("evento_stripe")
}

// O suporte da plataforma (bloco F4): avalia os pedidos de troca de
// link. Não é membro de barbearia nenhuma; a conta nasce só por comando
// (apps/api/scripts/criar-suporte.ts).
model OperadorSuporte {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome            String    @db.VarChar(120)
  email           String    @unique @db.VarChar(160)
  senhaHash       String    @map("senha_hash")
  ativo           Boolean   @default(true)
  senhaAlteradaEm DateTime? @map("senha_alterada_em") @db.Timestamptz
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  decisoes SolicitacaoTrocaLink[]
  avisos   Aviso[]

  @@map("operador_suporte")
}

// O pedido do dono pra trocar o link (bloco F4). status: pendente,
// aprovada, recusada ou cancelada (CHECK na migration
// 20261004200000_suporte); uma pendente por barbearia (índice parcial).
model SolicitacaoTrocaLink {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId String    @map("barbearia_id") @db.Uuid
  slugPedido  String    @map("slug_pedido") @db.VarChar(80)
  motivo      String?   @db.VarChar(500)
  status      String    @default("pendente") @db.VarChar(20)
  resposta    String?   @db.VarChar(500)
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  decididoEm  DateTime? @map("decidido_em") @db.Timestamptz
  decididoPor String?   @map("decidido_por") @db.Uuid

  barbearia Barbearia        @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  operador  OperadorSuporte? @relation(fields: [decididoPor], references: [id], onDelete: SetNull)

  @@index([status, criadoEm])
  @@map("solicitacao_troca_link")
}

// Slugs que a barbearia já teve (bloco E3): o link antigo continua
// achando ela. O atual de qualquer barbearia ganha do antigo — quem nasce
// ou troca para um slug daqui apaga a linha (migration
// 20261004180000_slug_antigo).
model SlugAntigo {
  slug        String   @id @db.VarChar(80)
  barbeariaId String   @map("barbearia_id") @db.Uuid
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@index([barbeariaId])
  @@map("slug_antigo")
}

model HorarioFuncionamento {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId    String    @map("barbearia_id") @db.Uuid
  diaSemana      Int       @map("dia_semana") @db.SmallInt
  horaAbertura   DateTime? @map("hora_abertura") @db.Time
  horaFechamento DateTime? @map("hora_fechamento") @db.Time
  fechado        Boolean   @default(false)

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@unique([barbeariaId, diaSemana])
  @@map("horario_funcionamento")
}

// Exceção por data no horário da barbearia (painel v2, marco 3): na data,
// substitui a linha do dia da semana. CHECK `excecao_horas_do_estado`
// (migration 20261008130000).
model ExcecaoHorario {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId    String    @map("barbearia_id") @db.Uuid
  data           DateTime  @db.Date
  fechado        Boolean   @default(false)
  horaAbertura   DateTime? @map("hora_abertura") @db.Time
  horaFechamento DateTime? @map("hora_fechamento") @db.Time
  motivo         String?   @db.VarChar(120)
  criadoEm       DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@unique([barbeariaId, data])
  @@map("excecao_horario")
}

model Barbeiro {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId      String      @map("barbearia_id") @db.Uuid
  nome             String      @db.VarChar(120)
  email            String?     @unique @db.VarChar(160)
  // Nulo enquanto o membro convidado não define a senha; o login recusa.
  senhaHash        String?     @map("senha_hash")
  telefone         String?     @db.VarChar(20)
  ativo            Boolean     @default(true)
  papel            PapelMembro @default(profissional)
  // Aparece na agenda e no fluxo público. A recepção nasce com false.
  atende           Boolean     @default(true)
  // Chave da foto no armazenamento (bloco E2); a URL sai da config.
  fotoChave        String?     @map("foto_chave") @db.VarChar(200)
  criadoEm         DateTime    @default(now()) @map("criado_em") @db.Timestamptz
  // Token com `iat` anterior a isto é recusado (plugins/auth.ts).
  senhaAlteradaEm  DateTime?   @map("senha_alterada_em") @db.Timestamptz
  // % que fica com a casa de tudo o que o membro atende (caixa, marco 2
  // da Onda 2; CHECK 0..100 na migration 20261017120000_caixa).
  parteDaCasa      Int         @default(0) @map("parte_da_casa") @db.SmallInt
  // A ordem na equipe e no link público, como a do serviço. O limite do
  // Grátis e o "qualquer um" seguem por `criadoEm`, não por ela
  // (migration 20261021120000_ordem).
  ordem            Int         @default(dbgenerated()) @db.SmallInt
  // O dono libera o membro pra vender planos ao cliente; o dono vende
  // sem ela (migration 20261026120000_planos_de_assinatura).
  podeVenderPlanos Boolean     @default(false) @map("pode_vender_planos")

  barbearia             Barbearia             @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  agendamentos          Agendamento[]
  // Sete linhas sempre, e todos os serviços ao nascer: quem garante é o
  // trigger do insert (migration 20261004120000), não as rotas.
  jornada               JornadaProfissional[]
  servicos              ProfissionalServico[]
  bloqueios             Bloqueio[]
  notificacoes          Notificacao[]
  // O caixa (migration 20261017120000_caixa).
  clientes              Cliente[]             @relation("DonoDoCliente")
  regrasComoDono        RegraDeDivisao[]      @relation("RegraDonoDoCliente")
  regrasComoAtendente   RegraDeDivisao[]      @relation("RegraAtendente")
  pagamentosAtendidos   Pagamento[]           @relation("PagamentoAtendente")
  pagamentosDosClientes Pagamento[]           @relation("PagamentoDonoDoCliente")
  pagamentosRecebidos   Pagamento[]           @relation("PagamentoRecebidoPor")
  pagamentosRegistrados Pagamento[]           @relation("PagamentoRegistradoPor")
  partesRecebidas       PagamentoParte[]
  fechamentos           FechamentoDoDia[]
  // Os planos do cliente (migration 20261026120000_planos_de_assinatura).
  conexoesDePagamento   ConexaoDePagamento[]
  planosVendidos        PlanoDeAssinatura[]
  recebimentosDePlanos  RecebimentoDoPlano[]

  @@index([barbeariaId])
  @@map("barbeiro")
}

model JornadaProfissional {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeiroId  String      @map("barbeiro_id") @db.Uuid
  diaSemana   Int         @map("dia_semana") @db.SmallInt
  modo        ModoJornada @default(barbearia)
  // Só no modo `proprio`, e as duas — CHECK `jornada_horas_do_modo`.
  horaInicio  DateTime?   @map("hora_inicio") @db.Time
  horaFim     DateTime?   @map("hora_fim") @db.Time
  // Pausa do almoço (painel v2, marco 3): as duas ou nenhuma, nunca na
  // folga — CHECK `jornada_pausa_inteira` (migration 20261008120000).
  pausaInicio DateTime?   @map("pausa_inicio") @db.Time
  pausaFim    DateTime?   @map("pausa_fim") @db.Time

  barbeiro Barbeiro @relation(fields: [barbeiroId], references: [id], onDelete: Cascade)

  @@unique([barbeiroId, diaSemana])
  @@map("jornada_profissional")
}

model ProfissionalServico {
  barbeiroId String @map("barbeiro_id") @db.Uuid
  servicoId  String @map("servico_id") @db.Uuid

  barbeiro Barbeiro @relation(fields: [barbeiroId], references: [id], onDelete: Cascade)
  servico  Servico  @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@id([barbeiroId, servicoId])
  @@index([servicoId])
  @@map("profissional_servico")
}

// Período de datas; sem horas é o dia inteiro, com horas é a mesma faixa
// em cada dia do período. CHECKs `bloqueio_periodo` e `bloqueio_horas`.
model Bloqueio {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId String    @map("barbearia_id") @db.Uuid
  barbeiroId  String    @map("barbeiro_id") @db.Uuid
  dataInicio  DateTime  @map("data_inicio") @db.Date
  dataFim     DateTime  @map("data_fim") @db.Date
  horaInicio  DateTime? @map("hora_inicio") @db.Time
  horaFim     DateTime? @map("hora_fim") @db.Time
  motivo      String?   @db.VarChar(120)
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  barbeiro  Barbeiro  @relation(fields: [barbeiroId], references: [id], onDelete: Cascade)

  @@index([barbeiroId, dataInicio, dataFim])
  @@index([barbeariaId, dataInicio])
  @@map("bloqueio")
}

model Cliente {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId     String    @map("barbearia_id") @db.Uuid
  nome            String    @db.VarChar(120)
  telefone        String    @db.VarChar(20)
  email           String?   @db.VarChar(160)
  senhaHash       String?   @map("senha_hash")
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  // Token com `iat` anterior a isto é recusado (plugins/auth.ts).
  senhaAlteradaEm DateTime? @map("senha_alterada_em") @db.Timestamptz
  // De quem o cliente "é" no caixa: quem atendeu primeiro, e o dono
  // troca à mão. Nulo = de ninguém ainda (migration 20261017120000_caixa).
  profissionalId  String?   @map("profissional_id") @db.Uuid
  // Só os 11 dígitos. O Asaas exige pra cobrar a assinatura online
  // (migration 20261028120000_mensalidade_online); nulo até o checkout.
  cpf             String?   @db.VarChar(11)

  barbearia    Barbearia             @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]
  profissional Barbeiro?             @relation("DonoDoCliente", fields: [profissionalId], references: [id], onDelete: SetNull)
  assinaturas  AssinaturaDoCliente[]

  // Telefone é único dentro da barbearia, não na plataforma: o mesmo
  // cliente pode ser cliente de duas barbearias, com um cadastro em
  // cada uma. É esse par que o upsert por telefone da fase 4 usa.
  @@unique([barbeariaId, telefone])
  @@unique([barbeariaId, email])
  @@index([barbeariaId])
  @@index([profissionalId])
  @@map("cliente")
}

model Servico {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId    String   @map("barbearia_id") @db.Uuid
  nome           String   @db.VarChar(120)
  duracaoMinutos Int      @map("duracao_minutos") @db.SmallInt
  preco          Decimal  @db.Decimal(10, 2)
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz
  // Agrupa os serviços na página pública. Opcional; só valor de
  // CATEGORIAS_DE_SERVICO em @barchop/formato (CHECK na migration
  // 20261011120000_categoria_fechada).
  categoria      String?  @db.VarChar(60)
  // Texto curto do cartão na página pública. Opcional.
  descricao      String?  @db.VarChar(300)
  // Chave da foto no armazenamento, como a do barbeiro; a URL sai da config.
  fotoChave      String?  @map("foto_chave") @db.VarChar(200)
  // A ordem que o dono escolheu, de 10 em 10 dentro da barbearia. Só
  // exibição. Sem valor no create, o trigger põe no fim (migration
  // 20261021120000_ordem).
  ordem          Int      @default(dbgenerated()) @db.SmallInt

  barbearia           Barbearia             @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  agendamentoServicos AgendamentoServico[]
  profissionais       ProfissionalServico[]
  planos              PlanoServico[]
  usosDePlanos        UsoDoPlano[]

  @@index([barbeariaId])
  @@map("servico")
}

model Agendamento {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId          String            @map("barbearia_id") @db.Uuid
  barbeiroId           String            @map("barbeiro_id") @db.Uuid
  clienteId            String            @map("cliente_id") @db.Uuid
  data                 DateTime          @db.Date
  horaInicio           DateTime          @map("hora_inicio") @db.Time
  horaFim              DateTime          @map("hora_fim") @db.Time
  status               StatusAgendamento @default(confirmado)
  origem               OrigemAgendamento @default(cliente)
  observacoes          String?
  criadoEm             DateTime          @default(now()) @map("criado_em") @db.Timestamptz
  // Marca de idempotência do lembrete (ver apps/api/src/lib/lembrete.ts).
  lembreteEnviadoEm    DateTime?         @map("lembrete_enviado_em") @db.Timestamptz
  // Confirmação de presença pelo link do lembrete (routers/lembretes.ts).
  presencaConfirmadaEm DateTime?         @map("presenca_confirmada_em") @db.Timestamptz
  // E-mail digitado ao marcar pela página pública, só pro lembrete deste
  // agendamento — nunca vai pro cadastro (ver a migration
  // 20261004150000_email_do_lembrete).
  emailLembrete        String?           @map("email_lembrete") @db.VarChar(160)

  barbearia Barbearia            @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  barbeiro  Barbeiro             @relation(fields: [barbeiroId], references: [id])
  cliente   Cliente              @relation(fields: [clienteId], references: [id])
  servicos  AgendamentoServico[]
  pagamento Pagamento?

  @@index([barbeiroId, data])
  @@index([clienteId])
  @@index([barbeariaId, data])
  @@map("agendamento")
}

model AgendamentoServico {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agendamentoId    String  @map("agendamento_id") @db.Uuid
  servicoId        String  @map("servico_id") @db.Uuid
  precoNoMomento   Decimal @map("preco_no_momento") @db.Decimal(10, 2)
  duracaoNoMomento Int     @map("duracao_no_momento") @db.SmallInt

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  servico     Servico     @relation(fields: [servicoId], references: [id])

  @@index([agendamentoId])
  @@map("agendamento_servico")
}

// O caixa do dia (Onda 2, marco 2; migration 20261017120000_caixa). A
// conta mora em packages/formato/src/caixa.ts. Dinheiro em centavos.

// A matriz "cliente de A, atendido por B" → % de A. Par sem linha = 0;
// CHECK de A ≠ B e de 0..100 na migration.
model RegraDeDivisao {
  barbeariaId     String @map("barbearia_id") @db.Uuid
  donoDoClienteId String @map("dono_do_cliente_id") @db.Uuid
  atendenteId     String @map("atendente_id") @db.Uuid
  percentual      Int    @db.SmallInt

  barbearia     Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  donoDoCliente Barbeiro  @relation("RegraDonoDoCliente", fields: [donoDoClienteId], references: [id], onDelete: Cascade)
  atendente     Barbeiro  @relation("RegraAtendente", fields: [atendenteId], references: [id], onDelete: Cascade)

  @@id([barbeariaId, donoDoClienteId, atendenteId])
  @@map("regra_de_divisao")
}

// Um por agendamento. `data` é a do agendamento (o dia do caixa). Quem
// atendeu, de quem era o cliente e quem recebeu ficam congelados no
// registro. `forma` com CHECK de FORMAS_DO_CAIXA: `plano` só no
// atendimento todo pelo plano (sem dinheiro); com serviço cobrado à
// parte, a forma é a do dinheiro. "Pelo plano" = `assinaturaId`.
model Pagamento {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId      String   @map("barbearia_id") @db.Uuid
  agendamentoId    String   @unique @map("agendamento_id") @db.Uuid
  data             DateTime @db.Date
  atendenteId      String   @map("atendente_id") @db.Uuid
  donoDoClienteId  String?  @map("dono_do_cliente_id") @db.Uuid
  recebidoPorId    String   @map("recebido_por_id") @db.Uuid
  forma            String
  servicosCentavos Int      @map("servicos_centavos")
  descontoCentavos Int      @default(0) @map("desconto_centavos")
  gorjetaCentavos  Int      @default(0) @map("gorjeta_centavos")
  registradoPorId  String   @map("registrado_por_id") @db.Uuid
  registradoEm     DateTime @default(now()) @map("registrado_em") @db.Timestamptz
  assinaturaId     String?  @map("assinatura_id") @db.Uuid

  barbearia     Barbearia            @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  agendamento   Agendamento          @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  atendente     Barbeiro             @relation("PagamentoAtendente", fields: [atendenteId], references: [id], onDelete: NoAction)
  donoDoCliente Barbeiro?            @relation("PagamentoDonoDoCliente", fields: [donoDoClienteId], references: [id], onDelete: NoAction)
  recebidoPor   Barbeiro             @relation("PagamentoRecebidoPor", fields: [recebidoPorId], references: [id], onDelete: NoAction)
  registradoPor Barbeiro             @relation("PagamentoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: NoAction)
  partes        PagamentoParte[]
  assinatura    AssinaturaDoCliente? @relation(fields: [assinaturaId], references: [id], onDelete: NoAction)
  usosDoPlano   UsoDoPlano[]

  @@index([barbeariaId, data])
  @@index([assinaturaId])
  @@map("pagamento")
}

// A divisão congelada de um pagamento. Beneficiário nulo = a casa.
// `motivo` com CHECK de MOTIVOS_DA_PARTE + `plano` (o fixo do plano da
// casa).
model PagamentoParte {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pagamentoId    String  @map("pagamento_id") @db.Uuid
  beneficiarioId String? @map("beneficiario_id") @db.Uuid
  motivo         String
  valorCentavos  Int     @map("valor_centavos")

  pagamento    Pagamento @relation(fields: [pagamentoId], references: [id], onDelete: Cascade)
  beneficiario Barbeiro? @relation(fields: [beneficiarioId], references: [id], onDelete: NoAction)

  @@index([pagamentoId])
  @@map("pagamento_parte")
}

// Um por barbearia e dia: a foto do acerto na hora de fechar. Com ele, o
// dia não aceita mudança de pagamento até o dono reabrir.
model FechamentoDoDia {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId  String   @map("barbearia_id") @db.Uuid
  data         DateTime @db.Date
  fechadoPorId String   @map("fechado_por_id") @db.Uuid
  fechadoEm    DateTime @default(now()) @map("fechado_em") @db.Timestamptz
  acerto       Json

  barbearia  Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  fechadoPor Barbeiro  @relation(fields: [fechadoPorId], references: [id], onDelete: NoAction)

  @@unique([barbeariaId, data])
  @@map("fechamento_do_dia")
}

// Os planos que a barbearia e os barbeiros vendem ao cliente (Onda 2,
// marco 3; migration 20261026120000_planos_de_assinatura). A conta mora
// em packages/formato/src/planos-do-cliente.ts. Dinheiro em centavos.

// A conta de quem vende num provedor. `daCasa` = a que recebe os planos
// da casa (uma por barbearia, índice parcial); fora ela, uma por membro,
// de qualquer provedor, as duas regras só entre as ligadas. A chave vai
// cifrada e nunca volta pra tela; o segredo do webhook da Stripe também
// (nulo no Asaas). Desconectar desliga (`desconectadaEm`, chave
// apagada) em vez de apagar: a assinatura online cancelada segue
// apontando pra conexão em que foi cobrada.
model ConexaoDePagamento {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId             String    @map("barbearia_id") @db.Uuid
  barbeiroId              String    @map("barbeiro_id") @db.Uuid
  daCasa                  Boolean   @default(false) @map("da_casa")
  provedor                String    @db.VarChar(20)
  modo                    String    @db.VarChar(10)
  chaveCifrada            Bytes     @map("chave_cifrada")
  chaveFinal              String    @map("chave_final") @db.VarChar(4)
  webhookTokenHash        String    @map("webhook_token_hash") @db.VarChar(128)
  idExternoWebhook        String?   @map("id_externo_webhook") @db.VarChar(100)
  segredoDoWebhookCifrado Bytes?    @map("segredo_do_webhook_cifrado")
  criadoEm                DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  desconectadaEm          DateTime? @map("desconectada_em") @db.Timestamptz

  barbearia   Barbearia             @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  barbeiro    Barbeiro              @relation(fields: [barbeiroId], references: [id], onDelete: NoAction)
  assinaturas AssinaturaDoCliente[]

  @@map("conexao_de_pagamento")
}

// Vendedor nulo = plano da casa, que tem o fixo por atendimento; o de
// barbeiro não tem (CHECK). Plano não é apagado: sai com `ativo = false`.
model PlanoDeAssinatura {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId                String   @map("barbearia_id") @db.Uuid
  vendedorId                 String?  @map("vendedor_id") @db.Uuid
  nome                       String   @db.VarChar(80)
  descricao                  String?  @db.VarChar(300)
  ciclo                      String   @db.VarChar(20)
  precoCentavos              Int      @map("preco_centavos")
  diasDeTeste                Int      @default(0) @map("dias_de_teste") @db.SmallInt
  fixoPorAtendimentoCentavos Int?     @map("fixo_por_atendimento_centavos")
  aceitaOnline               Boolean  @default(true) @map("aceita_online")
  aceitaNoBalcao             Boolean  @default(false) @map("aceita_no_balcao")
  ativo                      Boolean  @default(true)
  ordem                      Int      @default(0) @db.SmallInt
  criadoEm                   DateTime @default(now()) @map("criado_em") @db.Timestamptz

  barbearia   Barbearia             @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  vendedor    Barbeiro?             @relation(fields: [vendedorId], references: [id], onDelete: NoAction)
  servicos    PlanoServico[]
  assinaturas AssinaturaDoCliente[]

  @@index([barbeariaId])
  @@index([vendedorId])
  @@map("plano_de_assinatura")
}

// O que o plano cobre. Usos nulo = ilimitado.
model PlanoServico {
  planoId      String @map("plano_id") @db.Uuid
  servicoId    String @map("servico_id") @db.Uuid
  usosPorCiclo Int?   @map("usos_por_ciclo") @db.SmallInt

  plano   PlanoDeAssinatura @relation(fields: [planoId], references: [id], onDelete: Cascade)
  servico Servico           @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@id([planoId, servicoId])
  @@index([servicoId])
  @@map("plano_servico")
}

// Preço e ciclo congelados. Online tem conexão e o id no provedor; no
// balcão, não. Uma viva (não cancelada) por cliente e plano (índice
// parcial na migration).
model AssinaturaDoCliente {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId    String    @map("barbearia_id") @db.Uuid
  planoId        String    @map("plano_id") @db.Uuid
  clienteId      String    @map("cliente_id") @db.Uuid
  situacao       String    @default("pendente") @db.VarChar(20)
  forma          String    @db.VarChar(20)
  precoCentavos  Int       @map("preco_centavos")
  ciclo          String    @db.VarChar(20)
  conexaoId      String?   @map("conexao_id") @db.Uuid
  idExterno      String?   @map("id_externo") @db.VarChar(100)
  // O ciclo atual; nulos enquanto pendente.
  cicloComecaEm  DateTime? @map("ciclo_comeca_em") @db.Date
  cicloTerminaEm DateTime? @map("ciclo_termina_em") @db.Date
  // Online: o ciclo seguinte já pago antes da renovação vai até aqui, e
  // começa quando o atual acabar (cicloPagoOnline, @barchop/formato).
  pagoAte        DateTime? @map("pago_ate") @db.Date
  canceladaEm    DateTime? @map("cancelada_em") @db.Timestamptz
  criadoEm       DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  barbearia    Barbearia            @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  plano        PlanoDeAssinatura    @relation(fields: [planoId], references: [id], onDelete: NoAction)
  cliente      Cliente              @relation(fields: [clienteId], references: [id], onDelete: NoAction)
  conexao      ConexaoDePagamento?  @relation(fields: [conexaoId], references: [id], onDelete: NoAction)
  recebimentos RecebimentoDoPlano[]
  pagamentos   Pagamento[]
  usos         UsoDoPlano[]

  @@unique([conexaoId, idExterno])
  @@index([barbeariaId])
  @@index([clienteId])
  @@map("assinatura_do_cliente")
}

// Cada mensalidade que entrou, no dia do caixa (o da confirmação, ou o
// próximo aberto), com a parte da casa congelada.
model RecebimentoDoPlano {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeariaId   String   @map("barbearia_id") @db.Uuid
  assinaturaId  String   @map("assinatura_id") @db.Uuid
  data          DateTime @db.Date
  // Nulo = a casa: a mensalidade online do plano da casa caiu na conta
  // da casa, e não na mão de ninguém.
  recebidoPorId String?  @map("recebido_por_id") @db.Uuid
  valorCentavos Int      @map("valor_centavos")
  casaCentavos  Int      @map("casa_centavos")
  forma         String   @db.VarChar(20)
  // Só na online: como o cliente pagou no provedor.
  meio          String?  @db.VarChar(20)
  idExterno     String?  @map("id_externo") @db.VarChar(100)
  registradoEm  DateTime @default(now()) @map("registrado_em") @db.Timestamptz

  barbearia   Barbearia           @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  assinatura  AssinaturaDoCliente @relation(fields: [assinaturaId], references: [id], onDelete: NoAction)
  recebidoPor Barbeiro?           @relation(fields: [recebidoPorId], references: [id], onDelete: NoAction)

  @@unique([assinaturaId, idExterno])
  @@index([barbeariaId, data])
  @@map("recebimento_do_plano")
}

// Um por serviço coberto num atendimento pelo plano. Sai junto com o
// pagamento: desfazer o pagamento devolve o uso.
model UsoDoPlano {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pagamentoId  String   @map("pagamento_id") @db.Uuid
  assinaturaId String   @map("assinatura_id") @db.Uuid
  servicoId    String   @map("servico_id") @db.Uuid
  data         DateTime @db.Date

  pagamento  Pagamento           @relation(fields: [pagamentoId], references: [id], onDelete: Cascade)
  assinatura AssinaturaDoCliente @relation(fields: [assinaturaId], references: [id], onDelete: NoAction)
  servico    Servico             @relation(fields: [servicoId], references: [id], onDelete: NoAction)

  @@index([assinaturaId, data])
  @@index([pagamentoId])
  @@map("uso_do_plano")
}

// A deduplicação do webhook dos provedores, como `evento_stripe`.
model EventoDoProvedor {
  provedor   String   @db.VarChar(20)
  id         String   @db.VarChar(255)
  tipo       String   @db.VarChar(100)
  recebidoEm DateTime @default(now()) @map("recebido_em") @db.Timestamptz

  @@id([provedor, id])
  @@map("evento_do_provedor")
}

// O código de verificação do primeiro acesso e da recuperação de senha.
// Criado à mão na migration 20261001120000_codigo_verificacao — ver lá
// por que o código nunca é guardado em texto.
model CodigoVerificacao {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  finalidade  String    @db.VarChar(40)
  // Telefone ou e-mail, já normalizado: é o mesmo valor que a busca usa.
  destino     String    @db.VarChar(160)
  barbeariaId String?   @map("barbearia_id") @db.Uuid
  codigoHash  String    @map("codigo_hash")
  tentativas  Int       @default(0) @db.SmallInt
  expiraEm    DateTime  @map("expira_em") @db.Timestamptz
  usadoEm     DateTime? @map("usado_em") @db.Timestamptz
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  barbearia Barbearia? @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@index([finalidade, destino, barbeariaId, criadoEm(sort: Desc)], map: "codigo_verificacao_alvo_idx")
  @@map("codigo_verificacao")
}

// De onde vem a notificação do sino do painel. `pagamento` existe desde
// já, sem quem a gere: entra com a Onda 2 (dinheiro).
enum TipoNotificacao {
  agendamento
  pagamento
  plataforma

  @@map("tipo_notificacao")
}

// O aviso que o suporte publica pra todas as barbearias (plano
// barra-do-topo, PR B). Cada membro ativo na hora recebe a sua
// Notificacao com o aviso_id — é por ele que o suporte conta quantos
// leram. Quem entra na equipe depois não recebe os avisos antigos.
model Aviso {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo    String   @db.VarChar(120)
  texto     String   @db.VarChar(500)
  link      String?  @db.VarChar(300)
  criadoPor String?  @map("criado_por") @db.Uuid
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz

  operador     OperadorSuporte? @relation(fields: [criadoPor], references: [id], onDelete: SetNull)
  notificacoes Notificacao[]

  @@index([criadoEm(sort: Desc)])
  @@map("aviso")
}

// Uma linha por destinatário, e não uma por evento: o "lida" é de cada
// pessoa, e a equipe de uma barbearia é pequena. O texto é gravado
// pronto — se o cliente mudar de nome depois, o aviso conta o que
// aconteceu na hora. Ver a migration 20261013120000_notificacoes.
model Notificacao {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barbeiroId String          @map("barbeiro_id") @db.Uuid
  tipo       TipoNotificacao
  titulo     String          @db.VarChar(120)
  texto      String          @db.VarChar(500)
  // Caminho do painel ("/painel/agendamentos/…") ou https://, ou nada.
  link       String?         @db.VarChar(300)
  avisoId    String?         @map("aviso_id") @db.Uuid
  lidaEm     DateTime?       @map("lida_em") @db.Timestamptz
  criadaEm   DateTime        @default(now()) @map("criada_em") @db.Timestamptz

  barbeiro Barbeiro @relation(fields: [barbeiroId], references: [id], onDelete: Cascade)
  aviso    Aviso?   @relation(fields: [avisoId], references: [id], onDelete: Cascade)

  @@index([barbeiroId, criadaEm(sort: Desc)])
  @@index([avisoId])
  @@map("notificacao")
}
