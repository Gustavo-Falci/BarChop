# Variáveis que a API lê do ambiente. Copie este arquivo pra `.env` na
# mesma pasta e preencha os valores: o script de dev carrega esse .env
# sozinho, via `tsx watch --env-file-if-exists=.env` (ver package.json).
# O `--env-file-if-exists` e não o `--env-file` porque quem já exporta as
# variáveis no shell não precisa do arquivo — e o `--env-file` aborta se
# ele não existir.
#
# Variável já presente no ambiente ganha do arquivo: o Node não
# sobrescreve o que o shell exportou.
#
# O `pnpm --filter @barchop/api start` (bundle de produção) NÃO carrega
# .env nenhum, de propósito — em produção as variáveis vêm do systemd,
# do container ou do painel da OCI, não de arquivo no disco.
#
# A suíte de testes carrega outro arquivo, o apps/api/.env.test
# (veja o .env.test.example ao lado).

# Banco de DESENVOLVIMENTO — nunca o mesmo do .env.test, que é truncado
# a cada caso de teste.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/barchop?schema=public"

# Segredo de assinatura do JWT. Sem ele a API não sobe: o registrarAuth
# lança na montagem, e é de propósito — subir sem segredo publicaria
# rotas protegidas sem proteção nenhuma.
JWT_SECRET="troque-por-um-valor-aleatorio-longo"

# Por onde saem os códigos de verificação (primeiro acesso e esqueci a
# senha, convites, lembretes). Sem ela: `log` em desenvolvimento — o
# código aparece no terminal do `pnpm dev` — e `memoria` nos testes. Em
# produção a API NÃO sobe com `log` nem sem a variável: código no log é
# conta de quem lê o log. O provedor real do piloto é `email` (Resend),
# que exige as duas variáveis de baixo — sem elas a API não sobe.
# CANAL_DE_MENSAGEM="log"
# RESEND_API_KEY="re_..."
# EMAIL_REMETENTE="BarChop <nao-responda@barchop.com.br>"

# WhatsApp oficial (Cloud API da Meta), desligado até a Meta aprovar o
# negócio e os modelos (ADR-0009). `true` junta o WhatsApp pros
# telefones, mantendo o e-mail pros endereços; exige as duas de baixo, e
# só envia mensagem com modelo aprovado. Ausente ou `false` = desligado.
# WHATSAPP_ATIVO="false"
# WHATSAPP_TOKEN="EAA..."
# WHATSAPP_NUMERO_ID="..."
# WHATSAPP_VERSAO_API="v21.0"

# Endereço do painel web, sem barra no fim. Opcional: com ela, o e-mail
# de convite da equipe leva o link direto pra tela de aceitar, e o
# lembrete leva o link de confirmar ou cancelar; sem ela, vai só o
# código, e o lembrete sai sem link (a API avisa no log ao subir). Em desenvolvimento, o `pnpm dev` do web.
# URL_DO_PAINEL="http://localhost:3000"

# Onde ficam capa e fotos (bloco E2). Sem ela: `local` em desenvolvimento
# (pasta apps/api/.arquivos, servida pela própria API em /arquivos) e uma
# pasta temporária nos testes. Em produção a API NÃO sobe sem `s3`: o
# disco do contêiner some no próximo deploy. `s3` é o Object Storage da
# OCI pela API compatível (endpoint path-style), e exige todas abaixo.
# O bucket precisa de leitura pública dos objetos (sem listagem).
# ARMAZENAMENTO="local"
# URL_DA_API="http://localhost:3333"
# S3_ENDPOINT="https://<namespace>.compat.objectstorage.<regiao>.oraclecloud.com"
# S3_REGIAO="sa-saopaulo-1"
# S3_BUCKET="barchop-imagens"
# S3_CHAVE_DE_ACESSO="..."
# S3_SEGREDO="..."
# URL_PUBLICA_DAS_IMAGENS="https://objectstorage.<regiao>.oraclecloud.com/n/<namespace>/b/<bucket>/o"
