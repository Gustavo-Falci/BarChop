# Variáveis do compose (infra/compose.yaml). Na VM: copiar pra
# infra/.env e preencher LÁ — nunca no repo nem em chat. As da API
# moram em api.env (ver api.env.example).

# Banco. A senha entra crua na DATABASE_URL que o compose monta: gerar
# só hexadecimal, com `openssl rand -hex 24`.
POSTGRES_USER=barchop
POSTGRES_PASSWORD=
POSTGRES_DB=barchop

# Certificados (Caddy, desafio DNS-01). Token da Cloudflare com as DUAS
# permissões que o caddy-dns/cloudflare pede, só na zona barchop.com.br:
# Zone → Zone → Read e Zone → DNS → Edit. Só com o Edit a emissão falha.
# O e-mail recebe os avisos da Let's Encrypt.
CLOUDFLARE_API_TOKEN=
ACME_EMAIL=

# Embutidas no JavaScript do web na hora do build (web.Dockerfile):
# trocar uma delas pede `docker compose build web`.
NEXT_PUBLIC_API_URL=https://api.barchop.com.br
NEXT_PUBLIC_URL_DO_SITE=https://barchop.com.br

# Quantos dias de backup diário guardar.
BACKUP_DIAS=14
